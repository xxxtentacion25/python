class Student:
    def __init__(self, roll, name):
        self.roll = roll
        self.name = name
    def display(self):
        print("Roll No:", self.roll)
        print("Name:", self.name)
S1 = Student(1, "mohanumar")
S2 = Student(2, "srikanth")
s3 = Student(3, "dhanalakshmi")
S1.display()
S2.display()
s3.display()
