import asyncio
async def say_hello():
    print("Hello ... ")
    print("Wait 2 min....")
    await asyncio.sleep(1)   
    print("Hello after 2 seconds!")
async def say_bye():
    print("Bye ... ")
    print("wait 1 min...")
    await asyncio.sleep(2)   
    print("Bye after 1 second!")
async def main():
    await asyncio.gather(say_hello(), say_bye())
asyncio.run(main())
